# Database Configuration
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=atlas_password_change_me
POSTGRES_DB=atlas_db
# Internal URL (for containers to communicate with each other)
DATABASE_URL=postgresql://atlas_user:atlas_password_change_me@postgres:5432/atlas_db
# External port (for host machine access): 5434

# Redis Configuration
# Internal URL (for containers to communicate with each other)
REDIS_URL=redis://redis:6379
# External port (for host machine access): 6380

# JWT Secret (change this to a random string)
JWT_SECRET=your_jwt_secret_change_me_to_random_string

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Application Configuration
NODE_ENV=production
BACKEND_PORT=5001
FRONTEND_PORT=3001
CORS_ORIGIN=http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=10485760

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL=support@yourdomain.com
